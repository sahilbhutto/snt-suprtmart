# ============================================================
# SNT Supermart · root .gitignore
# Covers: React + Vite + TypeScript + Tailwind (frontend)
#         Node + Express + MongoDB (backend)
# ============================================================

# ---------- Dependencies ----------
notes.md
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
jspm_packages/

# ---------- Build output ----------
dist/
dist-ssr/
build/
out/
.output/
*.tsbuildinfo

# ---------- Environment variables and secrets ----------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
service-account*.json

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pm2/

# ---------- Runtime and cache ----------
pids/
*.pid
*.seed
*.pid.lock
.cache/
.parcel-cache/
.vite/
.eslintcache
.stylelintcache
.prettiercache
.turbo/
.nx/
.npm/
.node_repl_history
*.tgz

# ---------- Testing and coverage ----------
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
cypress/videos/
cypress/screenshots/
junit.xml

# ---------- Storybook and docs builds ----------
storybook-static/
docs/.vitepress/cache/
docs/.vitepress/dist/

# ---------- Uploads and generated files (keep real photos in S3 or Cloudinary) ----------
uploads/
public/uploads/
server/uploads/
tmp/
temp/
*.csv.tmp
exports/

# ---------- Local database data ----------
data/db/
mongo-data/
mongodb-data/
*.rdb
dump/
*.bson

# ---------- Deployment platforms ----------
.vercel/
.netlify/
.firebase/
.serverless/
.wrangler/
.railway/
.render/

# ---------- Docker (local overrides only) ----------
docker-compose.override.yml
.docker/

# ---------- Editors and IDEs ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.history/

# ---------- Operating system files ----------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Misc ----------
